{
  "name": "@hammies/inbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4",
    "ip-address": "10.3.1",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.0",
    "picomatch": "4.0.5",
    "postcss": "8.5.25",
    "shell-quote": "1.10.0",
    "undici@^7.0.0": "7.29.0",
    "ws": "8.21.1"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .husky",
    "typecheck": "npm --prefix ../.. run typecheck -- --scope inbox --quick",
    "typecheck:all": "npm --prefix ../.. run typecheck",
    "dev": "concurrently --kill-others -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bash scripts/with-node22.sh tsx watch --ignore '../agent/**/*' --ignore '../personal-agent/**/*' server/index.ts",
    "dev:stop": "for p in 3002 5175; do lsof -ti tcp:$p | xargs -I{} kill -9 {} 2>/dev/null; done; echo 'inbox dev servers (3002/5175) stopped'",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "tsc -b && vitest run",
    "docs:coverage": "STRICT_ORPHANS=1 node ../../scripts/check-docs-coverage.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css}\" --ignore-path .gitignore",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "migrate:credentials": "tsx server/scripts/migrate-env-to-vault.ts",
    "db:setup": "bash scripts/setup-postgres.sh",
    "start": "npm run build && nohup bash scripts/with-node22.sh node --env-file=../../.env --import tsx/esm server/index.ts --workspace ../agent > /tmp/inbox.log 2>&1 & echo $! > /tmp/inbox.pid && echo \"Started (PID $(cat /tmp/inbox.pid)), logs at /tmp/inbox.log\"",
    "stop": "if [ -f /tmp/inbox.pid ] && kill -0 $(cat /tmp/inbox.pid) 2>/dev/null; then kill $(cat /tmp/inbox.pid) && rm /tmp/inbox.pid && echo 'Stopped'; else echo 'Not running'; rm -f /tmp/inbox.pid; fi",
    "test:e2e": "playwright test --project=mocked",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:all": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "@babel/standalone": "^7.29.2",
    "@base-ui/react": "1.2.0",
    "@hammies/auth": "file:../auth",
    "@hammies/contracts": "file:../contracts",
    "@hammies/db": "file:../db",
    "@hammies/frontend": "file:../frontend",
    "@hammies/session-core": "file:../session-core",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.0",
    "@tailwindcss/browser": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/query-async-storage-persister": "^5.90.24",
    "@tanstack/query-persist-client-core": "^5.92.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.21",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/suggestion": "^3.20.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "hls.js": "^1.5.20",
    "hono": "^4.12.32",
    "idb-keyval": "^6.2.2",
    "lowlight": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "selfsigned": "^5.5.0",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
