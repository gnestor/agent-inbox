#!/bin/sh
# OpenSpec coverage check — fail fast if any spec references a missing path.
# Set STRICT_ORPHANS=1 in the environment to also fail on uncovered source files.
STRICT_ORPHANS=1 node ../../scripts/check-docs-coverage.mjs || exit 1

# Inbox is an independent repository, so its own hook must invoke the
# authoritative workspace gate. The gate includes both Inbox tsconfigs and
# prevents regressions below 100% coverage or the introduction of `any`.
npm run typecheck || exit 1
